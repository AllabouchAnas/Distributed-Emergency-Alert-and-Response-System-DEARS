# ============================================
# DATABASE CONFIGURATION
# ============================================
# Choose ONE of the following database configurations:

# Option 1: Local PostgreSQL (Development)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dears_db

# Option 2: Neon PostgreSQL (Cloud/Production)
DATABASE_URL=postgresql://neondb_owner:npg_tDG8paYj0RCT@ep-long-voice-ah63se0q-pooler.c-3.us-east-1.aws.neon.tech/neondb?sslmode=require

# Database Connection Pool Settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# SSL Mode (use 'require' for Neon, 'disable' for local development)
DB_SSL_MODE=require

# ============================================
# DISPATCHER SERVICE CONFIGURATION
# ============================================
DISPATCHER_HOST=0.0.0.0
DISPATCHER_PORT=8000

# ============================================
# PRIMARY RESPONSE SERVICES
# ============================================
RPC_POLICE_HOST=localhost
RPC_POLICE_PORT=9001

RPC_FIRE_HOST=localhost
RPC_FIRE_PORT=9002

RPC_MEDICAL_HOST=localhost
RPC_MEDICAL_PORT=9003

# ============================================
# SECONDARY RESPONSE SERVICES (FAILOVER)
# ============================================
# You can add up to 5 instances (2, 3, 4, 5)
# RPC_FIRE_HOST_2=localhost
# RPC_FIRE_PORT_2=9004

# ============================================
# RPC CALLBACK CONFIGURATION
# ============================================
# RPyC server (where services call back)
RPC_CALLBACK_HOST=http://localhost
RPC_CALLBACK_PORT=18000

# ============================================
# RPC SETTINGS
# ============================================
RPC_RETRIES=2
RPC_TIMEOUT=5

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=DEBUG
