# ============================================
# DATABASE CONFIGURATION
# ============================================
# Choose ONE of the following database configurations:

# Option 1: Local PostgreSQL (Development)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dears_db

# Option 2: Neon PostgreSQL (Cloud/Production)
# DATABASE_URL=postgresql://username:password@ep-xyz-pooler.us-east-2.aws.neon.tech/dears_db?sslmode=require

# Database Connection Pool Settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# SSL Mode (use 'require' for Neon, 'disable' for local development)
DB_SSL_MODE=disable

# ============================================
# SERVICE CONFIGURATION
# ============================================
FIRE_SERVICE_HOST=0.0.0.0
FIRE_SERVICE_PORT=9002

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=DEBUG
